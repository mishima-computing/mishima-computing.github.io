  <style>
    .agent-hero { padding-top: 10rem; padding-bottom: 5rem; }
    .agent-hero .hero-tagline { max-width: 880px; }
    .agent-section-note { max-width: 820px; color: var(--text-secondary); line-height: 1.9; }
    .agent-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; margin-top: 2.5rem; }
    .signal-list { list-style: none; padding: 0; margin: 1.5rem 0 0 0; color: var(--text-secondary); }
    .signal-list li { display: flex; gap: 0.7rem; align-items: flex-start; margin-bottom: 0.8rem; }
    .signal-list li::before { content: "✓"; color: var(--primary); font-weight: 800; }
    .flow-table th { width: 28%; }
    .machine-box { border: 1px solid var(--primary-glow); border-radius: var(--border-radius-lg); background: linear-gradient(135deg, rgba(6, 182, 212, 0.06), rgba(37, 99, 235, 0.04)); padding: 2rem; margin-top: 2rem; }
    .machine-box code { font-family: var(--font-mono); font-size: 0.88rem; color: var(--primary); }
    .faq-item { border-bottom: 1px solid var(--border-color); padding: 1.5rem 0; }
    .faq-item h3 { font-size: 1.15rem; margin-bottom: 0.6rem; }
    
    /* Flowchart Styles */
    .ai-flowchart { max-width: 750px; margin: 3rem auto; padding: 2.5rem; background: var(--bg-secondary); border-radius: var(--border-radius-lg); border: 1px solid var(--border-color); box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1); }
    .flow-node { text-align: center; margin-bottom: 1.2rem; }
    .flow-pill { display: inline-block; padding: 1rem 1.8rem; border-radius: 12px; background: var(--bg-primary); border: 1px solid var(--border-color); font-weight: 500; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); position: relative; z-index: 2; }
    .flow-pill.highlight { background: linear-gradient(135deg, rgba(6, 182, 212, 0.1), rgba(37, 99, 235, 0.1)); border-color: var(--primary-glow); }
    .flow-arrow-down { text-align: center; color: var(--text-secondary); margin-bottom: 1.2rem; font-size: 1.2rem; }
    .flow-tree { border-left: 2px solid var(--primary-glow); margin: 0 0 1.2rem 2.5rem; padding: 1.5rem 0 1.5rem 2.5rem; position: relative; }
    .flow-tree-item { position: relative; margin-bottom: 1.5rem; background: var(--bg-primary); padding: 1.5rem; border-radius: var(--border-radius-md); border: 1px solid var(--border-color); display: flex; align-items: center; gap: 2rem; }
    .flow-path-img { width: 200px; height: 150px; flex-shrink: 0; border-radius: var(--border-radius-md); background-image: url('../assets/images/ai_pathways_4.jpg'); background-size: 200% 200%; border: 1px solid var(--border-color); box-shadow: 0 4px 15px rgba(0,0,0,0.15); }
    .flow-tree-text { flex-grow: 1; }
    .flow-tree-item::before { content: ''; position: absolute; left: -2.5rem; top: 50%; width: 2.5rem; height: 2px; background: var(--primary-glow); }
    .flow-tree-item:last-child { margin-bottom: 0; }
    .flow-tree-title { font-weight: 700; font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--text-primary); }
    .flow-tree-desc { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6; }

    @media (max-width: 992px) { 
      .agent-grid { grid-template-columns: 1fr !important; } 
      .flow-table th { width: auto; }
      .ai-flowchart { padding: 1.5rem; }
      .flow-tree { margin-left: 1rem; padding-left: 1.5rem; }
      .flow-tree-item::before { left: -1.5rem; width: 1.5rem; }
    }
    @media (max-width: 600px) {
      .flow-tree-item { flex-direction: column; text-align: center; gap: 1rem; }
      .flow-tree-item::before { top: 2.5rem; }
      .flow-path-img { width: 200px; height: 150px; }
    }
  </style>
