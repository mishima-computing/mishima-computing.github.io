/* --- CONTAINERS & LAYOUT --- */
.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  min-width: 0;
}

.section {
  padding: 8rem 0 6rem 0;
  position: relative;
}

/* --- HEADER & NAVIGATION --- */
.header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background-color: var(--glass-bg);
  border-bottom: 1px solid var(--glass-border);
  backdrop-filter: var(--backdrop-blur);
  -webkit-backdrop-filter: var(--backdrop-blur);
  box-shadow: var(--glass-shadow);
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 5rem;
  gap: 1rem;
  min-width: 0;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-primary);
  flex: 1 1 auto;
  min-width: 0;
}

.nav-brand > div {
  min-width: 0;
}

.nav-brand span {
  display: block;
  max-width: 100%;
  line-height: 1.15;
  overflow-wrap: anywhere;
}

.nav-brand img {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 2px solid var(--primary);
  box-shadow: 0 0 10px var(--primary-glow);
}

.nav-brand .brand-jp {
  font-size: 0.8rem;
  font-weight: 400;
  color: var(--text-muted);
  display: block;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 2rem;
  list-style: none;
  min-width: 0;
}

.nav-link {
  display: flex;
  flex-direction: column;
  justify-content: center;
  color: var(--text-secondary);
  font-size: 0.95rem;
  font-weight: 500;
  position: relative;
  padding: 0.5rem 0;
  min-width: 0;
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background-color: var(--primary);
  transition: transform var(--transition-fast), opacity var(--transition-fast);
  transform: scaleX(0);
  transform-origin: left;
  opacity: 0;
}

.nav-link:hover {
  color: var(--text-primary);
}

.nav-link:hover::after {
  width: 100%;
  transform: scaleX(1);
  opacity: 1;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex: 0 0 auto;
}

/* Control Buttons */
.icon-btn {
  background: none;
  border: 1px solid var(--glass-border);
  background-color: var(--glass-bg);
  color: var(--text-primary);
  cursor: pointer;
  width: 40px;
  height: 40px;
  min-width: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.icon-btn:hover {
  border-color: var(--primary);
  color: var(--primary);
  box-shadow: 0 0 15px var(--primary-glow);
  transform: translateY(-2px);
}

/* Language Toggle Button */
.lang-btn {
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.85rem;
  border: 1px solid var(--glass-border);
  background-color: var(--glass-bg);
  color: var(--text-primary);
  padding: 0.5rem 1rem;
  min-height: 40px;
  min-width: 44px;
  border-radius: 20px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.lang-btn:hover {
  border-color: var(--primary);
  color: var(--primary);
  box-shadow: 0 0 15px var(--primary-glow);
  transform: translateY(-2px);
}

/* Mobile Menu Toggle */
.menu-toggle {
  display: none;
}

/* --- HERO SECTION --- */
.hero {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  padding-top: 5rem;
}

.hero-first-viewport {
  min-height: calc(100vh - 5rem);
  display: flex;
  align-items: center;
  padding: 3rem 0;
}

.hero-ledger {
  display: grid;
  grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
  gap: clamp(1.5rem, 4vw, 3rem);
  align-items: center;
  width: 100%;
  min-width: 0;
}

.hero-ledger-copy {
  max-width: 680px;
  min-width: 0;
}

.hero-proof {
  margin: 2rem 0 1.5rem 0;
}

.proof-link,
.proof-neighbor a,
.trust-register a {
  display: inline-flex;
  align-items: center;
  flex-direction: column;
  min-height: 2.5rem;
  max-width: 100%;
  min-width: 0;
  padding: 0.65rem 0.85rem;
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-sm);
  background: var(--bg-secondary);
  color: var(--primary);
  font-family: var(--font-mono);
  font-size: 0.86rem;
  line-height: 1.35;
  overflow-wrap: anywhere;
  word-break: break-word;
  white-space: normal;
}

.proof-neighbor {
  margin-top: 1.5rem;
}

.trust-register {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0.8rem;
  align-content: start;
  min-width: 0;
}

.proof-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 2rem;
}

.proof-strip a {
  display: inline-flex;
  min-height: 2.5rem;
  align-items: center;
  max-width: 100%;
  min-width: 0;
  padding: 0.55rem 0.8rem;
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-sm);
  background: var(--bg-secondary);
  font-family: var(--font-mono);
  font-size: 0.86rem;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.hero-claim {

