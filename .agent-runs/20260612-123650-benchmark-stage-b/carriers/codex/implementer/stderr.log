h2 > .lang-en,
h3 > .lang-en,
h4 > .lang-en,
p > .lang-en,
.card-body > .lang-en,
.footer-desc > .lang-en {
  margin-top: 0.45rem;
}

h1 > .lang-en {
  font-size: 0.42em;

