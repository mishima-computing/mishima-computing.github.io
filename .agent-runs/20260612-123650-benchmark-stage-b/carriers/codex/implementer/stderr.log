/* --- DESIGN SYSTEM TOKENS --- */
:root {
  /* Fonts */
  --font-heading: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-body: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;

  /* HSL Colors - Default Dark Mode (Deep Basalt, Spring Teal, Fuji Sky, Taisha Gold) */
  --bg-primary: hsl(224, 40%, 8%);
  --bg-secondary: hsl(224, 40%, 12%);
  --bg-tertiary: hsl(224, 40%, 16%);
  
  --text-primary: hsl(210, 40%, 98%);
  --text-secondary: hsl(215, 20%, 75%);
  --text-muted: hsl(215, 15%, 55%);
  
  --primary: hsl(188, 90%, 50%); /* Clean Spring Water Cyan */
  --primary-glow: hsla(188, 90%, 50%, 0.15);
  --secondary: hsl(217, 91%, 60%); /* Fuji Indigo */
  --secondary-glow: hsla(217, 91%, 60%, 0.15);
  --accent-gold: hsl(45, 95%, 50%); /* Taisha Shrine Gold */
  --accent-vermilion: hsl(8, 85%, 50%); /* Taisha Shrine Gate vermilion */
  
  /* Borders & Glassmorphism */
  --border-color: hsla(215, 20%, 25%, 0.4);
  --border-glow: hsla(188, 90%, 50%, 0.2);
  --glass-bg: hsla(224, 40%, 8%, 0.7);
  --glass-border: hsla(210, 40%, 98%, 0.08);
  --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
  --backdrop-blur: blur(16px);
  
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.2);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.3);
  --shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.5);

  --transition-fast: 160ms cubic-bezier(0.2, 0, 0, 1);
  --transition-normal: 260ms cubic-bezier(0.2, 0, 0, 1);

  --border-radius-sm: 6px;
  --border-radius-md: 12px;
  --border-radius-lg: 20px;
  --border-radius-xl: 30px;
}

/* --- LIGHT MODE TOKENS --- */
[data-theme="light"] {
  --bg-primary: hsl(210, 40%, 98%);
  --bg-secondary: hsl(0, 0%, 100%);
  --bg-tertiary: hsl(210, 30%, 94%);
  
  --text-primary: hsl(224, 40%, 12%);
  --text-secondary: hsl(224, 20%, 35%);
  --text-muted: hsl(224, 15%, 50%);
  
  --primary: hsl(188, 95%, 30%); /* Darker teal for accessibility */
  --primary-glow: hsla(188, 95%, 30%, 0.1);
  --secondary: hsl(217, 85%, 50%);
  --secondary-glow: hsla(217, 85%, 50%, 0.1);
  --accent-gold: hsl(42, 95%, 30%);
  --accent-vermilion: hsl(8, 85%, 45%);
  
  --border-color: hsla(224, 20%, 85%, 0.8);
  --border-glow: hsla(188, 95%, 40%, 0.15);
  --glass-bg: hsla(0, 0%, 100%, 0.75);
  --glass-border: hsla(224, 20%, 15%, 0.08);
  --glass-shadow: 0 8px 32px 0 rgba(15, 23, 42, 0.08);
  
  --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.04);
  --shadow-md: 0 8px 24px rgba(15, 23, 42, 0.06);
  --shadow-lg: 0 16px 40px rgba(15, 23, 42, 0.1);
}

/* --- RESET & BASIC STYLES --- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
}

[id] {
  scroll-margin-top: 6.5rem;
}

body {
  font-family: var(--font-body);
  background-color: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.6;
  overflow-x: visible;
}

a,
code,
kbd,
samp,
pre {
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-word;
}

/* --- CORE BACKGROUND EFFECTS --- */
.grid-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -2;
  background-image: 
    linear-gradient(var(--border-color) 1px, transparent 1px),
    linear-gradient(90deg, var(--border-color) 1px, transparent 1px);
  background-size: 80px 80px;
  background-position: center;
  opacity: 0.15;
  pointer-events: none;
}

.glow-orb {
  position: fixed;
  width: min(600px, 100vw);
  height: min(600px, 100vw);
  border-radius: 50%;
  z-index: -1;
  filter: blur(150px);
  pointer-events: none;
  opacity: 0.45;
}

.orb-1 {
  top: -100px;
  right: -100px;
  background: radial-gradient(circle, var(--primary) 0%, transparent 70%);
}


