}

.card {
  background-color: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--border-radius-lg);
  padding: 3rem 2.5rem;
  box-shadow: var(--glass-shadow);
  backdrop-filter: var(--backdrop-blur);
  -webkit-backdrop-filter: var(--backdrop-blur);
  transition: transform var(--transition-normal), opacity var(--transition-normal);
  position: relative;
  overflow: hidden;
  min-width: 0;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(800px circle at var(--x, 0px) var(--y, 0px), rgba(6, 182, 212, 0.08), transparent 40%);
  z-index: 1;
  pointer-events: none;
  opacity: 0;
  transition: opacity var(--transition-fast);
}

.card:hover::before {
  opacity: 1;
}

.card:hover {
  transform: translateY(-8px);
  border-color: var(--border-glow);
  box-shadow: 0 20px 40px rgba(6, 182, 212, 0.08);
}

.card-icon {
  width: 60px;
  height: 60px;
  border-radius: var(--border-radius-md);
  background: linear-gradient(135deg, var(--bg-tertiary), var(--border-color));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.75rem;
  color: var(--primary);
  margin-bottom: 2rem;
  border: 1px solid var(--glass-border);
  box-shadow: var(--shadow-sm);
  transition: transform var(--transition-normal), opacity var(--transition-normal);
}

.card:hover .card-icon {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: hsl(224, 40%, 8%);
  box-shadow: 0 0 20px var(--primary-glow);
}

.card-title {
  margin-bottom: 1rem;
  font-weight: 700;
}

.card-body {
  font-size: 0.95rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* --- ABOUT & CORPORATE PROFILE --- */
.about-wrapper {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 4rem;
  align-items: center;
}

.about-info p {
  font-size: 1.1rem;
  line-height: 1.8;
  margin-bottom: 2rem;
}

.profile-table {
  width: 100%;
  border-collapse: collapse;
  background-color: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: var(--border-radius-md);
  overflow: hidden;
  box-shadow: var(--glass-shadow);
  backdrop-filter: var(--backdrop-blur);
  -webkit-backdrop-filter: var(--backdrop-blur);
  table-layout: fixed;
  max-width: 100%;
}

.profile-table tr {
  border-bottom: 1px solid var(--glass-border);
}

.profile-table tr:last-child {
  border-bottom: none;
}

.profile-table th, .profile-table td {
  padding: 1.25rem 1.5rem;
  text-align: left;
  font-size: 0.95rem;

