agent-readiness/index.html:224:    .agent-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; margin-top: 2.5rem; }
agent-readiness/index.html:226:    .signal-list li { display: flex; gap: 0.7rem; align-items: flex-start; margin-bottom: 0.8rem; min-width: 0; }
agent-readiness/index.html:227:    .signal-list li::before { content: "✓"; color: var(--primary); font-weight: 800; }
agent-readiness/index.html:229:    .machine-box { border: 1px solid var(--primary-glow); border-radius: var(--border-radius-lg); background: linear-gradient(135deg, rgba(6, 182, 212, 0.06), rgba(37, 99, 235, 0.04)); padding: 2rem; margin-top: 2rem; min-width: 0; }
agent-readiness/index.html:230:    .machine-box code { font-family: var(--font-mono); font-size: 0.88rem; color: var(--primary); overflow-wrap: anywhere; word-break: break-word; }
agent-readiness/index.html:232:    .faq-item h3 { font-size: 1.15rem; margin-bottom: 0.6rem; }
agent-readiness/index.html:235:    .ai-flowchart { max-width: 750px; margin: 3rem auto; padding: 2.5rem; background: var(--bg-secondary); border-radius: var(--border-radius-lg); border: 1px solid var(--border-color); box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1); }
agent-readiness/index.html:237:    .flow-pill { display: inline-block; max-width: 100%; padding: 1rem 1.8rem; border-radius: 12px; background: var(--bg-primary); border: 1px solid var(--border-color); font-weight: 500; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); position: relative; z-index: 2; overflow-wrap: anywhere; word-break: break-word; }
agent-readiness/index.html:239:    .flow-arrow-down { text-align: center; color: var(--text-secondary); margin-bottom: 1.2rem; font-size: 1.2rem; }
agent-readiness/index.html:241:    .flow-tree-item { position: relative; margin-bottom: 1.5rem; background: var(--bg-primary); padding: 1.5rem; border-radius: var(--border-radius-md); border: 1px solid var(--border-color); display: flex; align-items: center; gap: 2rem; min-width: 0; }
agent-readiness/index.html:242:    .flow-path-img { width: 200px; height: 150px; flex-shrink: 0; border-radius: var(--border-radius-md); background-image: url('../assets/images/ai_pathways_4.jpg'); background-size: 200% 200%; border: 1px solid var(--border-color); box-shadow: 0 4px 15px rgba(0,0,0,0.15); }
agent-readiness/index.html:246:    .flow-tree-title { font-weight: 700; font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--text-primary); }
agent-readiness/index.html:247:    .flow-tree-desc { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6; }
agent-readiness/index.html:257:      .flow-tree-item { flex-direction: column; text-align: center; gap: 1rem; }
