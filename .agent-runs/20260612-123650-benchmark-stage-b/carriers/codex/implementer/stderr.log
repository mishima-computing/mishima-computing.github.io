from html.parser import HTMLParser
from pathlib import Path
class P(HTMLParser):
 def __init__(self): super().__init__(); self.stack=[]; self.items=[]
 def handle_starttag(self, tag, attrs):
  d=dict(attrs); cls=d.get('class','')
  line=self.getpos()[0]
  self.stack.append((tag,cls,line))
  if 'lang-ja' in cls or 'lang-en' in cls:
   self.items.append((line,tag,cls,' > '.join(f'{t}.{c}' if c else t for t,c,l in self.stack[-5:])))
 def handle_endtag(self, tag):
  for i in range(len(self.stack)-1,-1,-1):
   if self.stack[i][0]==tag:
    self.stack=self.stack[:i]
    break
p=P(); p.feed(Path('agent-readiness/index.html').read_text())
