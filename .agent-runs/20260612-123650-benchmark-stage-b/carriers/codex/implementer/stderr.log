    border-bottom: 1px solid var(--glass-border);
  }

  .profile-table td {
    border-bottom: 1px solid var(--glass-border);
  }
  
  .footer-content {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  
  .footer-bottom {
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }
  
  .modal-content {
    padding: 3rem 1.5rem 1.5rem 1.5rem;
  }
}

/* --- CONTACT SECTION --- */
.contact-container {
  max-width: 650px;
