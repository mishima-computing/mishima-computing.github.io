from pathlib import Path
from html.parser import HTMLParser
# Lightweight immediate-pair audit using line-order heuristics for all lang-en class tags.
import re
for path in ['index.html','contact/index.html','agent-readiness/index.html','privacy/index.html','kessan/index.html','reports/waterfall-agents/index.html','assets/js/app.js']:
    text=Path(path).read_text()
    unpaired=[]
    for m in re.finditer(r'<(?P<tag>\\w+)(?P<attrs>["'^>]*class="[''^"]*'"\\blang-en\\b["'^"]*"[''^>]*)>'"', text):
        before=text[max(0,m.start()-350):m.start()]
        if m.group('tag') == 'meta':
            continue
        if not re.search(r'<\\w+["'^>]*class="[''^"]*'"\\blang-ja\\b["'^"]*"[''^>]*>[''^<]*(?:<[''^/][''^>]*>[''^<]*</[''^>]+>[''^<]*)*'"\\s*"'$'"', before, re.S):
            # This heuristic misses nested long content, print for manual review.
            line=text.count('\\n',0,m.start())+1
            unpaired.append((line,m.group(0)[:160]))
    print(path, 'possible unpaired lang-en:', len(unpaired))
    for line,snippet in unpaired[:20]: print(' ', line, snippet)
