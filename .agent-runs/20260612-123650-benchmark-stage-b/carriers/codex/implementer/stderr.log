  border-radius: 100px;
  font-size: 0.85rem;
  color: var(--primary);
  margin-bottom: 2rem;
  backdrop-filter: var(--backdrop-blur);
  -webkit-backdrop-filter: var(--backdrop-blur);
  box-shadow: 0 0 20px var(--primary-glow);
  font-weight: 600;
  letter-spacing: 0;
  text-transform: uppercase;
}

.hero-pill .pulse {
  width: 8px;
  height: 8px;
