/* --- DESIGN SYSTEM TOKENS --- */
:root {
  /* Fonts */
  --font-heading: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-body: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;

  /* HSL Colors - Default Dark Mode (Deep Basalt, Spring Teal, Fuji Sky, Taisha Gold) */
  --bg-primary: hsl(224, 40%, 8%);
  --bg-secondary: hsl(224, 40%, 12%);
  --bg-tertiary: hsl(224, 40%, 16%);
  
  --text-primary: hsl(210, 40%, 98%);
  --text-secondary: hsl(215, 20%, 75%);
  --text-muted: hsl(215, 15%, 55%);
  
  --primary: hsl(188, 90%, 50%); /* Clean Spring Water Cyan */
  --primary-glow: hsla(188, 90%, 50%, 0.15);
  --secondary: hsl(217, 91%, 60%); /* Fuji Indigo */
  --secondary-glow: hsla(217, 91%, 60%, 0.15);
  --accent-gold: hsl(45, 95%, 50%); /* Taisha Shrine Gold */
  --accent-vermilion: hsl(8, 85%, 50%); /* Taisha Shrine Gate vermilion */
  
  /* Borders & Glassmorphism */
  --border-color: hsla(215, 20%, 25%, 0.4);
  --border-glow: hsla(188, 90%, 50%, 0.2);
  --glass-bg: hsla(224, 40%, 8%, 0.7);
  --glass-border: hsla(210, 40%, 98%, 0.08);
  --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
  --backdrop-blur: blur(16px);
  
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.2);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.3);
  --shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.5);

  --transition-fast: 160ms cubic-bezier(0.2, 0, 0, 1);
  --transition-normal: 260ms cubic-bezier(0.2, 0, 0, 1);

  --border-radius-sm: 6px;
  --border-radius-md: 12px;
  --border-radius-lg: 20px;
  --border-radius-xl: 30px;
}

/* --- LIGHT MODE TOKENS --- */
[data-theme="light"] {
  --bg-primary: hsl(210, 40%, 98%);
  --bg-secondary: hsl(0, 0%, 100%);
  --bg-tertiary: hsl(210, 30%, 94%);
  
  --text-primary: hsl(224, 40%, 12%);
  --text-secondary: hsl(224, 20%, 35%);
  --text-muted: hsl(224, 15%, 50%);
  
  --primary: hsl(188, 95%, 40%); /* Darker teal for accessibility */
  --primary-glow: hsla(188, 95%, 40%, 0.1);
  --secondary: hsl(217, 85%, 50%);
  --secondary-glow: hsla(217, 85%, 50%, 0.1);
  --accent-gold: hsl(42, 95%, 45%);
  --accent-vermilion: hsl(8, 85%, 45%);
  
  --border-color: hsla(224, 20%, 85%, 0.8);
  --border-glow: hsla(188, 95%, 40%, 0.15);
  --glass-bg: hsla(0, 0%, 100%, 0.75);
  --glass-border: hsla(224, 20%, 15%, 0.08);
  --glass-shadow: 0 8px 32px 0 rgba(15, 23, 42, 0.08);
  
  --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.04);
  --shadow-md: 0 8px 24px rgba(15, 23, 42, 0.06);
  --shadow-lg: 0 16px 40px rgba(15, 23, 42, 0.1);
}

/* --- RESET & BASIC STYLES --- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
}

[id] {
  scroll-margin-top: 6.5rem;
}

body {
  font-family: var(--font-body);
  background-color: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.6;
  overflow-x: hidden;
  transition: background-color var(--transition-normal), color var(--transition-normal);
}

/* --- CORE BACKGROUND EFFECTS --- */
.grid-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -2;
  background-image: 
    linear-gradient(var(--border-color) 1px, transparent 1px),
    linear-gradient(90deg, var(--border-color) 1px, transparent 1px);
  background-size: 80px 80px;
  background-position: center;
  opacity: 0.15;
  pointer-events: none;
}

.glow-orb {
  position: fixed;
  width: 600px;
  height: 600px;
  border-radius: 50%;
  z-index: -1;
  filter: blur(150px);
  pointer-events: none;
  opacity: 0.45;
}

.orb-1 {
  top: -100px;
  right: -100px;
  background: radial-gradient(circle, var(--primary) 0%, transparent 70%);
}

.orb-2 {
  bottom: -200px;
  left: -200px;
  background: radial-gradient(circle, var(--secondary) 0%, transparent 70%);
}

.fuji-silhouette {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 1400px;
  height: auto;
  opacity: 0.08;
  z-index: -1;
  pointer-events: none;
  fill: var(--text-primary);
  transition: fill var(--transition-normal), opacity var(--transition-normal);
}

/* --- SCROLLBAR --- */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
::-webkit-scrollbar-track {
  background: var(--bg-primary);
}
::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: var(--border-radius-sm);
}
::-webkit-scrollbar-thumb:hover {
  background: var(--primary);
}

/* --- TYPOGRAPHY --- */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  font-weight: 700;
  line-height: 1.25;
  color: var(--text-primary);
  letter-spacing: 0;
}

h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 800; }
h2 { font-size: clamp(2rem, 4vw, 3rem); position: relative; margin-bottom: 2.5rem; display: inline-block; }
h3 { font-size: clamp(1.3rem, 2vw, 1.8rem); margin-bottom: 1rem; }
h4 { font-size: 1.15rem; }

p {
  color: var(--text-secondary);
  font-size: 1.05rem;
  margin-bottom: 1.5rem;
  font-weight: 300;
}

a {
  color: var(--primary);
  text-decoration: none;
  transition: color var(--transition-fast);
}
a:hover {
  color: var(--secondary);
}

/* Section Title Highlight */
h2::after {
  content: '';
  position: absolute;
  bottom: -10px;
  left: 0;
  width: 60px;
  height: 4px;
  background: linear-gradient(90deg, var(--primary), var(--secondary));
  border-radius: 2px;
}

/* --- BILINGUAL VISIBLE SUPPORT --- */
.lang-ja,
.lang-en {
  overflow-wrap: anywhere;
}

.lang-en[lang="en"],
.lang-en:not([lang]) {
  color: var(--text-secondary);
}
.trust-register {
  display: grid;
  gap: 0.8rem;
  align-content: start;
}

.hero-claim {
  padding: 8rem 0 4rem 0;
  max-width: 840px;
}

.hero-claim-title {
  font-size: clamp(2rem, 4vw, 3.25rem);
}

.hero-cta-single {
  margin-top: 0;
}

.hero-content {
  max-width: 800px;
  z-index: 1;
}

.hero-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1.25rem;
  background-color: var(--glass-bg);
  border: 1px solid var(--primary-glow);
  border-radius: 100px;
  font-size: 0.85rem;
  color: var(--primary);
  margin-bottom: 2rem;
  backdrop-filter: var(--backdrop-blur);
  -webkit-backdrop-filter: var(--backdrop-blur);
  box-shadow: 0 0 20px var(--primary-glow);
  font-weight: 600;
  letter-spacing: 0;
  text-transform: uppercase;
}

.hero-pill .pulse {
  width: 8px;
  height: 8px;
  background-color: var(--primary);
  border-radius: 50%;
  box-shadow: 0 0 0 4px var(--primary-glow);
}

.hero-title {
  margin-bottom: 1.5rem;
  background: linear-gradient(135deg, var(--text-primary) 30%, var(--primary) 70%, var(--secondary) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-tagline {
  font-size: clamp(1.2rem, 2.5vw, 1.6rem);
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 3rem;
  font-weight: 300;
}

.hero-cta {
  display: flex;
  gap: 1.5rem;
  flex-wrap: wrap;
}

/* --- BUTTONS --- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  padding: 1rem 2rem;
  font-size: 1rem;
  font-weight: 600;
  border-radius: var(--border-radius-md);
  cursor: pointer;
  min-height: 2.75rem;
  transition: transform var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast), box-shadow var(--transition-fast), opacity var(--transition-fast), filter var(--transition-fast);
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: hsl(224, 40%, 8%);
  box-shadow: 0 8px 24px var(--primary-glow);
}

.btn-primary:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 30px var(--primary-glow);
  filter: brightness(1.1);
}

.btn-secondary {
  background-color: var(--glass-bg);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  backdrop-filter: var(--backdrop-blur);
  -webkit-backdrop-filter: var(--backdrop-blur);
}

.btn-secondary:hover {
  transform: translateY(-3px);
  border-color: var(--primary);
  box-shadow: 0 8px 24px rgba(6, 182, 212, 0.1);
}

/* --- METRICS / QUICK STATS --- */
.hero-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  margin-top: 5rem;
  margin-bottom: 0.5rem;
}

/* --- STATIC REPORT DETAIL --- */
.static-report-detail {
  margin-top: 1.5rem;
  border-top: 1px solid var(--border-color);
  padding-top: 1rem;
}

.static-report-detail summary {
  cursor: pointer;
  color: var(--primary);
  font-weight: 700;
}

.static-report-detail h3 {
  font-size: 1.05rem;
  margin-top: 1.25rem;
}

/* --- FOCUS AND REDUCED MOTION --- */
:focus-visible {
  outline: 3px solid var(--accent-gold);
  outline-offset: 4px;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition: none !important;
    animation: none !important;
  }
}

/* --- RESPONSIVE DESIGN --- */
@media (max-width: 992px) {
  .navbar {
    height: 4.5rem;
