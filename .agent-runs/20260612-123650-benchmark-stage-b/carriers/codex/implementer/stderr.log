reports/waterfall-agents/index.html:570:          <div style="display: flex; align-items: center; gap: 1rem;">
reports/waterfall-agents/index.html:571:            <div style="flex: 1; text-align: right; color: var(--text-secondary); font-size: 0.85rem;">Adopted local state</div>
