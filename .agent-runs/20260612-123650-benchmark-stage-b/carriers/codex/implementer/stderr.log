  position: absolute;
  bottom: -10px;
  left: 0;
  width: 60px;
  height: 4px;
  background: linear-gradient(90deg, var(--primary), var(--secondary));
  border-radius: 2px;
}

/* --- LANGUAGE VISIBILITY --- */
.lang-ja,
.lang-en {
  overflow-wrap: anywhere;
}

.entity-title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 800;
  line-height: 1.25;
}

.hero-entity-title {
  font-size: clamp(2.5rem, 4.8vw, 3.1rem);
}

.hero-company-name {
  overflow-wrap: normal;
  word-break: keep-all;
  line-break: strict;
  text-wrap: balance;
}

.hero-company-name .company-suffix {
  display: inline-block;
}

.proof-link .lang-ja,
.proof-link .lang-en,
.hero-pill .lang-ja,
.hero-pill .lang-en,
.btn .lang-ja,
.btn .lang-en,
.read-more .lang-ja,
.read-more .lang-en {
  max-width: 100%;
  min-width: 0;
}

html:not([lang="en"]) .lang-ja + .lang-en {
  display: none !important;
}

html[lang="en"] .lang-ja:has(+ .lang-en) {
  display: none !important;
}

/* --- CONTAINERS & LAYOUT --- */
.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  min-width: 0;
}

.section {
  padding: 8rem 0 6rem 0;
  position: relative;
}

/* --- HEADER & NAVIGATION --- */
.header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  background-color: var(--glass-bg);
  border-bottom: 1px solid var(--glass-border);
  backdrop-filter: var(--backdrop-blur);
  -webkit-backdrop-filter: var(--backdrop-blur);
  box-shadow: var(--glass-shadow);
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 5rem;
  gap: 1rem;
  min-width: 0;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-primary);
  flex: 1 1 auto;
  min-width: 0;
}

.nav-brand > div {
  min-width: 0;
}

.nav-brand span {
  display: block;
  max-width: 100%;
  line-height: 1.15;
  overflow-wrap: anywhere;
}

.nav-brand img {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 2px solid var(--primary);
  box-shadow: 0 0 10px var(--primary-glow);
}

.nav-brand .brand-jp {
  font-size: 0.8rem;
  font-weight: 400;
  color: var(--text-muted);
  display: block;
}


