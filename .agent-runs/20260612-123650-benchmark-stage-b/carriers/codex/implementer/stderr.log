/* --- REPORTS INTERACTIVE --- */
.report-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
  gap: 2rem;
}

.report-card {
  cursor: pointer;
}

.report-tag {
  display: inline-block;
  padding: 0.25rem 0.75rem;
  background-color: var(--bg-tertiary);
  border-radius: 4px;
  font-size: 0.75rem;
  font-family: var(--font-mono);
  color: var(--primary);
  margin-bottom: 1rem;
  border: 1px solid var(--glass-border);
}

.report-card:hover .report-tag {
  background-color: var(--primary);
  color: hsl(224, 40%, 8%);
  border-color: var(--primary);
}

.report-date {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-bottom: 0.5rem;
  font-family: var(--font-mono);
}

.report-card .read-more {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.9rem;
  font-weight: 600;
  margin-top: 1.5rem;
  color: var(--primary);
}

.report-card .read-more svg {
  transition: transform var(--transition-fast);
}

.report-card:hover .read-more svg {
  transform: translateX(5px);
}

/* --- KESSAN (PUBLIC NOTICE) LAYOUT --- */
.kessan-header {
  text-align: center;
  padding: 10rem 0 4rem 0;
  background: radial-gradient(circle at top, var(--primary-glow), transparent 60%);
}

.kessan-title {
  margin-bottom: 1rem;
}

.kessan-intro {
  max-width: 600px;
  margin: 0 auto;
  color: var(--text-secondary);
}

.kessan-card {
  max-width: 800px;
  margin: 0 auto 4rem auto;
  border-color: var(--primary-glow);
}

.kessan-card-header {
  border-bottom: 1px solid var(--glass-border);
  padding-bottom: 1.5rem;
  margin-bottom: 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.kessan-status {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  padding: 0.35rem 1rem;
  background-color: hsla(45, 95%, 50%, 0.1);
  border: 1px solid var(--accent-gold);
  border-radius: 30px;
  color: var(--accent-gold);
  font-weight: 600;
}

.construction-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 3rem 1rem;
}

.construction-icon {
  width: 100px;
  height: 100px;
  margin-bottom: 2rem;
  position: relative;
}

.construction-icon svg {
  width: 100%;
  height: 100%;
  fill: none;
  stroke: var(--accent-gold);
  stroke-width: 1.5;
  filter: drop-shadow(0 0 15px var(--accent-gold));
  animation: spin-slow 20s linear infinite;
}

.construction-icon::after {
  content: '富士';
  font-family: var(--font-heading);
  font-size: 0.8rem;
  font-weight: 800;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: var(--primary);
  text-shadow: 0 0 10px var(--primary-glow);
}

.construction-headline {
  font-size: 1.75rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color: var(--text-primary);
}

.construction-text {
  max-width: 500px;
  color: var(--text-secondary);
  font-size: 1rem;
  line-height: 1.8;
  margin-bottom: 2.5rem;
}

.construction-steps {
  width: 100%;
  max-width: 500px;
  text-align: left;
  border-top: 1px solid var(--glass-border);
  padding-top: 2rem;
}

.step-item {
  display: flex;
  gap: 1rem;
  margin-bottom: 1.25rem;
}

.step-bullet {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background-color: var(--bg-tertiary);
  border: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  font-family: var(--font-mono);
  font-weight: 600;
  color: var(--primary);
  flex-shrink: 0;
}

.step-item.active .step-bullet {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  border-color: var(--primary);
  color: hsl(224, 40%, 8%);
  box-shadow: 0 0 10px var(--primary-glow);
}

.step-info h4 {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 0.25rem;
}

.step-info p {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin: 0;
}

/* --- GITHUB INTEGRATION SECTION --- */
.github-section {
  position: relative;
  z-index: 1;
}

.github-card {
  display: flex;
  gap: 3rem;
  align-items: center;
  border-color: var(--secondary-glow);
  padding: 4rem;
}

.github-info {
  flex: 1.2;
}

.github-avatar {
  flex: 0.8;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.avatar-wrapper {
  position: relative;
  width: 200px;
  height: 200px;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4px solid var(--secondary);
  box-shadow: 0 0 30px var(--secondary-glow);
  z-index: 1;
  position: relative;
}

.avatar-glow {
  position: absolute;
  top: -10px;
  left: -10px;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  border: 1px dashed var(--primary);
  animation: spin-slow 30s linear infinite;
  opacity: 0.6;
}

/* --- FOOTER --- */
.footer {
  border-top: 1px solid var(--border-color);
  padding: 5rem 0 3rem 0;
  background-color: var(--bg-secondary);
}

.footer-content {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr;
  gap: 4rem;
  margin-bottom: 4rem;
}

.footer-brand {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.footer-logo {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.2rem;
  color: var(--text-primary);
}

.footer-logo img {
  width: 32px;
  height: 32px;
  border-radius: 50%;
}

.footer-desc {
  font-size: 0.9rem;
  color: var(--text-muted);
  max-width: 320px;
}

.footer-links-title {
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 1.5rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.footer-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.footer-links a {
  color: var(--text-secondary);
  font-size: 0.9rem;
}

.footer-links a:hover {
  color: var(--primary);
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--border-color);
  padding-top: 2rem;
  font-size: 0.85rem;
  color: var(--text-muted);
}

/* --- INTERACTIVE MODALS --- */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition-normal);
}

.modal.active {
  opacity: 1;
  pointer-events: all;
}

.modal-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(11, 15, 25, 0.8);
  backdrop-filter: blur(8px);
}

.modal-content {
  position: relative;
  background-color: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius-lg);
  width: 90%;
  max-width: 800px;
  max-height: 85vh;
  overflow-y: auto;
  padding: 4rem 3rem 3rem 3rem;
  box-shadow: var(--shadow-lg);
  z-index: 2;
  transform: scale(0.95);
  transition: transform var(--transition-normal);
}

.modal.active .modal-content {
  transform: scale(1);
}

.modal-close {
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  background: none;
  border: none;
  color: var(--text-secondary);
  font-size: 1.5rem;
  cursor: pointer;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-fast);
}


