The final static checks are clean for encoding and motion, with only the reduced-motion `animation: none` override present. I’m calculating contrast sample ratios and then adding the artifact files.
exec
/bin/zsh -lc "node - <<'NODE'
function hslToRgb(h,s,l){s/=100;l/=100;const c=(1-Math.abs(2*l-1))*s;const x=c*(1-Math.abs((h/60)%2-1));const m=l-c/2;let r=0,g=0,b=0;if(h<60){r=c;g=x}else if(h<120){r=x;g=c}else if(h<180){g=c;b=x}else if(h<240){g=x;b=c}else if(h<300){r=x;b=c}else{r=c;b=x}return [r+m,g+m,b+m].map(v=>Math.round(v*255));}
function lum(rgb){return rgb.map(v=>{v/=255;return v<=0.03928?v/12.92:Math.pow((v+0.055)/1.055,2.4)}).reduce((a,v,i)=>a+v*[0.2126,0.7152,0.0722][i],0)}
function ratio(a,b){const A=lum(a),B=lum(b);return ((Math.max(A,B)+0.05)/(Math.min(A,B)+0.05)).toFixed(2)}
const samples=[
 ['dark text primary on bg primary',hslToRgb(210,40,98),hslToRgb(224,40,8)],
