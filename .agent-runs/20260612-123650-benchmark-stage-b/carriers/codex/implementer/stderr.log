  border-right: 1px solid var(--glass-border);
  background-color: rgba(6, 182, 212, 0.02);
}

.profile-table td {
  color: var(--text-primary);
  font-weight: 300;
}

/* --- REPORTS INTERACTIVE --- */
.report-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  gap: 2rem;
}

.report-card {
  cursor: pointer;
}

.report-tag {
  display: inline-block;
