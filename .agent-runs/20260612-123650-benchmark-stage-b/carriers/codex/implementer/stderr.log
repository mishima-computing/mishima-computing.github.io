The quick regex audit is too noisy because it cannot understand nested HTML. I’m switching to a small parser-based sibling audit so the result matches the actual selectors.
exec
/bin/zsh -lc "python3 - <<'PY'
from html.parser import HTMLParser
from pathlib import Path
VOID={'area','base','br','col','embed','hr','img','input','link','meta','param','source','track','wbr'}
class Node:
    def __init__(self,tag='root',attrs=None,parent=None,line=0):
        self.tag=tag; self.attrs=dict(attrs or []); self.parent=parent; self.children=[]; self.line=line
    @property
    def cls(self): return self.attrs.get('class','').split()
class Parser(HTMLParser):
    def __init__(self): super().__init__(); self.root=Node(); self.stack=[self.root]
    def handle_starttag(self, tag, attrs):
        n=Node(tag,attrs,self.stack[-1],self.getpos()[0]); self.stack[-1].children.append(n)
        if tag not in VOID: self.stack.append(n)
    def handle_endtag(self, tag):
        for i in range(len(self.stack)-1,0,-1):
            if self.stack[i].tag==tag:
                self.stack=self.stack[:i]
                return
    def handle_startendtag(self, tag, attrs): self.handle_starttag(tag,attrs)

def nodes(n):
    for c in n.children:
        yield c; yield from nodes(c)

def prev_elem(n):
    if not n.parent: return None
    kids=[c for c in n.parent.children if isinstance(c, Node)]
    i=kids.index(n)
    return kids[i-1] if i else None

def next_elem(n):
    if not n.parent: return None
    kids=[c for c in n.parent.children if isinstance(c, Node)]
    i=kids.index(n)
    return kids[i+1] if i+1 < len(kids) else None

files=['index.html','contact/index.html','agent-readiness/index.html','privacy/index.html','kessan/index.html','reports/waterfall-agents/index.html']
for f in files:
    p=Parser(); p.feed(Path(f).read_text())
    en_unpaired=[]; ja_unpaired=[]
    for n in nodes(p.root):
        if 'lang-en' in n.cls and n.tag "'!= '"'meta':
            pr=prev_elem(n)
            if not pr or 'lang-ja' not in pr.cls:
                en_unpaired.append((n.line,n.tag,n.attrs.get('class',''), pr.tag if pr else None, pr.attrs.get('class','') if pr else ''))
        if 'lang-ja' in n.cls:
            nx=next_elem(n)
            if not nx or 'lang-en' not in nx.cls:
                ja_unpaired.append((n.line,n.tag,n.attrs.get('class',''), nx.tag if nx else None, nx.attrs.get('class','') if nx else ''))
    print(f)
    print(' en not immediately after ja:', len(en_unpaired))
    for item in en_unpaired[:30]: print('  ',item)
    print(' ja not immediately before en:', len(ja_unpaired))
    for item in ja_unpaired[:30]: print('  ',item)
