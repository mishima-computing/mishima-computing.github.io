from math import ceil
rem=16
for viewport in (320,390):
    container = viewport - 2*rem
    gap = 0.5*rem
    basis = max(5.6*rem, min(0.30*container, 8*rem))
    per_row = max(1, int((container + gap)//(basis + gap)))
    rows = ceil(5/per_row)
    header_px = (0.65*rem) + 44 + (0.75*rem) + rows*44 + max(0, rows-1)*gap + (0.75*rem)
    hero_padding_px = 11*rem
    hero_badge_start_px = hero_padding_px + 3*rem
    print({
        'viewport': viewport,
        'container_px': round(container, 2),
        'nav_basis_px': round(basis, 2),
        'nav_columns': per_row,
        'nav_rows': rows,
        'estimated_header_bottom_px': round(header_px, 2),
        'hero_padding_top_px': round(hero_padding_px, 2),
        'hero_badge_start_px': round(hero_badge_start_px, 2),
        'hero_top_clearance_px': round(hero_padding_px - header_px, 2),
        'badge_clearance_px': round(hero_badge_start_px - header_px, 2),
    })
